{
  "name": "Underwriting Doc Request Task",
  "description": "When a deal's stage changes to under_review, automatically create a high-priority document request task and log a pipeline velocity alert",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"stage\") != null) and (.trigger.data.stage == \"under_review\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Deal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "underwriting_doc_request_task",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onDealUnderReview",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onDealUnderReview"
  }
}