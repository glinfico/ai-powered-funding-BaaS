{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event ID"
    },
    "title": {
      "type": "string",
      "description": "Event title/summary"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "start_time": {
      "type": "string",
      "description": "Event start datetime (ISO string)"
    },
    "end_time": {
      "type": "string",
      "description": "Event end datetime (ISO string)"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of attendee emails"
    },
    "html_link": {
      "type": "string",
      "description": "Link to the Google Calendar event"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "tentative",
        "cancelled"
      ],
      "default": "confirmed",
      "description": "Event status"
    },
    "lead_id": {
      "type": "string",
      "description": "Linked CRM lead ID (if matched)"
    }
  },
  "required": [
    "google_event_id",
    "title"
  ]
}