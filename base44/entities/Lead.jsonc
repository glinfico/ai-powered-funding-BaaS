{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Lead's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Lead's last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Lead's email address"
    },
    "phone": {
      "type": "string",
      "description": "Lead's phone number"
    },
    "company": {
      "type": "string",
      "description": "Company or business name"
    },
    "loan_type": {
      "type": "string",
      "enum": [
        "business_loan",
        "equipment_financing",
        "commercial_real_estate",
        "sba_loan",
        "line_of_credit",
        "invoice_factoring",
        "merchant_cash_advance",
        "other"
      ],
      "description": "Type of loan requested"
    },
    "loan_amount": {
      "type": "number",
      "description": "Requested loan amount"
    },
    "credit_score_range": {
      "type": "string",
      "enum": [
        "excellent_750+",
        "good_700-749",
        "fair_650-699",
        "poor_below_650",
        "unknown"
      ],
      "description": "Credit score range"
    },
    "annual_revenue": {
      "type": "number",
      "description": "Annual business revenue (self-reported)"
    },
    "years_in_business": {
      "type": "number",
      "description": "Years the business has been operating"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "proposal_sent",
        "negotiation",
        "approved",
        "funded",
        "lost"
      ],
      "default": "new",
      "description": "Current status in the pipeline"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "referral",
        "cold_call",
        "partner",
        "social_media",
        "email_campaign",
        "trade_show",
        "other"
      ],
      "description": "Lead source"
    },
    "assigned_to": {
      "type": "string",
      "description": "Team member assigned to this lead"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Lead priority level"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the lead"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last contact"
    },
    "next_follow_up": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled follow-up date"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document URLs"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "completed",
        "failed"
      ],
      "default": "not_started",
      "description": "Status of automated enrichment"
    },
    "credit_idq_score": {
      "type": "number",
      "description": "Soft-pull business credit score"
    },
    "credit_idq_summary": {
      "type": "string",
      "description": "Summary of business credit soft pull results"
    },
    "verified_annual_revenue": {
      "type": "number",
      "description": "AI-verified annual revenue estimate"
    },
    "revenue_verified_source": {
      "type": "string",
      "description": "Source used to verify business revenue"
    },
    "business_owner_found": {
      "type": "boolean",
      "default": false,
      "description": "Whether the business owner was identified"
    },
    "property_address": {
      "type": "string",
      "description": "Property address (for CRE / real estate loans)"
    },
    "property_estimated_value": {
      "type": "number",
      "description": "AI-estimated property market value"
    },
    "property_value_source": {
      "type": "string",
      "description": "Source/method used for property valuation"
    },
    "property_ltv": {
      "type": "number",
      "description": "Estimated loan-to-value % for property"
    },
    "due_diligence_score": {
      "type": "number",
      "description": "AI due diligence risk score 0-100 (100 = cleanest)"
    },
    "due_diligence_summary": {
      "type": "string",
      "description": "AI-generated due diligence summary and risk flags"
    },
    "due_diligence_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of risk flags identified during due diligence"
    },
    "due_diligence_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "completed",
        "failed"
      ],
      "default": "not_started",
      "description": "Status of due diligence check"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "loan_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "broker"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "loan_officer"
          }
        },
        {
          "user_condition": {
            "role": "processor"
          }
        },
        {
          "user_condition": {
            "role": "broker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "loan_officer"
          }
        },
        {
          "user_condition": {
            "role": "processor"
          }
        },
        {
          "user_condition": {
            "role": "broker"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}